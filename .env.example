# Example environment variables for docto-ppointment
# Copy this to .env and fill with real values (never commit secrets).

# Email backend (use SMTP in production)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# Optional: set DEBUG to False in production
DEBUG=True

# Django secret key (generate a strong value for production)
# DJANGO_SECRET_KEY=django-insecure-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
